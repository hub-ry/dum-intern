{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/workshop/**/*.ts", "src/public/**/*.ts", "src/discord/**/*.ts", "src/context/**/*.ts", "src/client/**/*.ts", "src/shared/**/*.ts", "src/mcp/**/*.ts", "src/internship/**/*.ts", "src/cli.ts"]
}
