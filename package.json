{
  "name": "dum-intern",
  "version": "0.0.1",
  "description": "Backend for Dum's workshop: study, attempt, and teach Dum, then flip through the creation it built from your teaching.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "tsx src/workshop/server.ts",
    "dev": "tsx watch src/workshop/server.ts",
    "note": "tsx src/workshop/notes-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/workshop/*.test.ts"
  },
  "dependencies": {
    "tsx": "^4.23.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
