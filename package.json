{
  "name": "dum-intern",
  "version": "0.1.0",
  "description": "Teach a programming intern. It can only do the skills you explained, on a desktop you can watch.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-sqlite --import tsx src/server.ts",
    "dev": "node --experimental-sqlite --watch-path=src --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
