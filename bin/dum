#!/usr/bin/env bash
# dum-intern launcher. Runs the package's own tsx: the panes are JSX, which Node can't strip.
set -euo pipefail

# `npm link` makes this a symlink, and macOS readlink has no -f, hence the loop.

target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  dir="$(cd -P "$(dirname "$target")" && pwd)"
  target="$(readlink "$target")"
  [[ "$target" != /* ]] && target="$dir/$target"
done
root="$(cd -P "$(dirname "$target")/.." && pwd)"

# Node warnings on stderr land on top of the panes; DUM_DEBUG brings them back.
[ -n "${DUM_DEBUG:-}" ] || export NODE_NO_WARNINGS=1

exec "$root/node_modules/.bin/tsx" "$root/src/cli.tsx" "$@"
