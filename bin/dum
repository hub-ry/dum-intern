#!/usr/bin/env bash
# dum-intern launcher. Runs the package's own tsx loader: Node can't strip types from cli.tsx.
set -euo pipefail

# `npm link` makes this a symlink, and macOS readlink has no -f, hence the loop.

target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  dir="$(cd -P "$(dirname "$target")" && pwd)"
  target="$(readlink "$target")"
  [[ "$target" != /* ]] && target="$dir/$target"
done
root="$(cd -P "$(dirname "$target")/.." && pwd)"

# Node warnings on stderr land in the middle of the conversation; DUM_DEBUG brings them back.
[ -n "${DUM_DEBUG:-}" ] || export NODE_NO_WARNINGS=1

# A requested restart loads the edited sources in a fresh process.
while true; do
  code=0
  node --import "$root/node_modules/tsx/dist/loader.mjs" "$root/src/cli.tsx" "$@" || code=$?
  [ "$code" -eq 75 ] || exit "$code"
  export DUM_RESTARTED=1
done
