# OpenAI-compatible chat API. DeepSeek is the default.
# The app runs in mock mode when LLM_API_KEY or MARITIME_API_KEY is empty.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Maritime computers. A bearer mk_ key with the computers scope, or a manage key.
# https://maritime.sh/docs/computers
MARITIME_API_KEY=
MARITIME_API_BASE=https://api.maritime.sh

# The server binds loopback unless you set HOST. cloudflared can point at that port.
HOST=127.0.0.1
PORT=8074

# SQLite database, chat, and exported skill markdown.
DUM_STATE=./data

# Milliseconds between mock desktop steps. Use 0 in tests.
# DUM_PACE_MS=380
