% Shared style for every document on learn.ryhub.dev.
% Use with:  \documentclass[11pt]{article}  \usepackage{learn}
% The build passes ~/learn as a search path, so this file is found from any tab.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{learn}

\RequirePackage[margin=0.9in]{geometry}
\RequirePackage{lmodern}
\RequirePackage[T1]{fontenc}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage[shortlabels]{enumitem}
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}
\RequirePackage{titlesec}
\RequirePackage[hidelinks]{hyperref}

\definecolor{learnaccent}{HTML}{C2410C}
\definecolor{learnmuted}{HTML}{57534E}
\definecolor{learncode}{HTML}{F5F5F4}

\hypersetup{colorlinks=true, linkcolor=learnaccent, urlcolor=learnaccent}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\setlist{itemsep=0.2em, topsep=0.3em}

\titleformat{\section}{\large\bfseries\color{learnaccent}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}

% Inline code.
\newcommand{\code}[1]{\texttt{#1}}
% Video timestamp, printed muted after a point.
\newcommand{\ts}[1]{\textcolor{learnmuted}{\small(#1)}}

% Syntax colors for code listings. Warm, dark-on-light versions of the site's
% terminal palette, so they also read well when the viewer inverts the page.
\definecolor{learnkw}{HTML}{C2410C}      % keywords (the accent)
\definecolor{learnstr}{HTML}{15803D}     % strings
\definecolor{learncomment}{HTML}{78716C} % comments
\definecolor{learnnum}{HTML}{6D28D9}     % numbers and True/False/None
\definecolor{learnbuiltin}{HTML}{1E40AF} % builtins and common commands

% Color digits only in plain code; the * keeps them out of strings and comments.
\newcommand*{\learn@num}[1]{%
  \ifnum\lst@mode=\lst@Pmode\relax\textcolor{learnnum}{#1}\else#1\fi}
\newcommand*{\learnnumbers}{%
  \lstset{literate=*%
    {0}{{\learn@num{0}}}1 {1}{{\learn@num{1}}}1 {2}{{\learn@num{2}}}1
    {3}{{\learn@num{3}}}1 {4}{{\learn@num{4}}}1 {5}{{\learn@num{5}}}1
    {6}{{\learn@num{6}}}1 {7}{{\learn@num{7}}}1 {8}{{\learn@num{8}}}1
    {9}{{\learn@num{9}}}1}}

% Languages listings doesn't ship.
\lstdefinelanguage{tmux}{
  morekeywords={set,set-option,setw,set-window-option,bind,bind-key,unbind,unbind-key,
    source-file,run-shell,if-shell,new-session,new-window,split-window,select-pane},
  morekeywords=[2]{on,off},
  alsoletter={-}, sensitive=true, morecomment=[l]{\#}, morestring=[b]", morestring=[b]',
}
\lstdefinelanguage{TypeScript}[]{Java}{
  morekeywords={abstract,any,as,async,await,boolean,const,constructor,declare,enum,
    export,extends,from,function,get,implements,import,in,infer,instanceof,interface,
    is,keyof,let,module,namespace,never,number,of,readonly,require,set,string,symbol,
    type,typeof,undefined,unique,unknown,var,yield},
  morekeywords=[2]{true,false,null,undefined,NaN,Infinity},
  morekeywords=[3]{console,Promise,Array,Object,Map,Set,JSON,Math,Error,fetch},
  morestring=[b]`, sensitive=true,
}
\lstdefinelanguage{JSON}{
  morekeywords=[2]{true,false,null},
  morestring=[b]", sensitive=true,
}

\lstset{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{learncode},
  frame=single, rulecolor=\color{learncode},
  framesep=4pt, xleftmargin=4pt, xrightmargin=4pt,
  keywordstyle=\bfseries\color{learnkw},
  keywordstyle=[2]\color{learnnum},
  keywordstyle=[3]\color{learnbuiltin},
  commentstyle=\itshape\color{learncomment},
  stringstyle=\color{learnstr},
  showstringspaces=false, columns=fullflexible, keepspaces=true,
  breaklines=true, tabsize=4, upquote=true,
}
\learnnumbers

% Extra words per language, layered on listings' own keyword lists. Use the
% styles below (style=py, style=sh, ...) to get them; C++ gets them by default.
\lstdefinelanguage{learnpy}[]{Python}{
  morekeywords={async,await,with,yield,nonlocal,match,case,self},
  morekeywords=[2]{True,False,None},
  morekeywords=[3]{len,range,enumerate,zip,sorted,reversed,min,max,sum,abs,int,float,
    str,list,dict,set,tuple,bool,map,filter,any,all,isinstance,input,open,iter,next,
    ord,chr,divmod,pow,round,hash,id,type,super,object,print,
    deque,defaultdict,Counter,heapq,heappush,heappop,heapify,bisect,bisect_left,bisect_right},
}
\lstdefinelanguage[learn]{C++}[ISO]{C++}{
  morekeywords={nullptr,constexpr,noexcept,override,final,auto,decltype,
    static_assert,thread_local,alignas,alignof,char16_t,char32_t},
  morekeywords=[2]{true,false,NULL},
  morekeywords=[3]{std,vector,string,map,unordered_map,set,unordered_set,pair,queue,
    stack,deque,priority_queue,cout,cin,endl,size_t,printf,malloc,free,sort,swap,min,max},
}
\lstdefinelanguage{learnsh}[]{bash}{
  morekeywords=[2]{true,false},
  morekeywords=[3]{git,tmux,ssh,nvim,vim,sudo,rsync,systemctl,journalctl,npm,node,
    python3,pip,cargo,make,cmake,docker,curl,grep,rg,fd,fdfind,ls,cp,mv,rm,mkdir,ln,
    chmod,chown,cat,tail,head,find,sed,awk,tar,claude,codex,tailscale,cloudflared,tectonic},
}
\lstset{defaultdialect=[learn]C++,
  language=learnpy} % Python is the default when a listing doesn't say

\lstdefinestyle{py}{language=learnpy}
\lstdefinestyle{cpp}{language=C++}
\lstdefinestyle{sh}{language=learnsh}
\lstdefinestyle{ts}{language=TypeScript}
\lstdefinestyle{json}{language=JSON}
\lstdefinestyle{tmux}{language=tmux}

% A question to answer in your own words.
\newtcolorbox{why}[1][]{colback=learnaccent!6, colframe=learnaccent,
  boxrule=0.6pt, arc=2pt, left=6pt, right=6pt,
  title={Why? Answer in your own words}, fonttitle=\bfseries\small, #1}

% A point that matters more than the rest.
\newtcolorbox{keypoint}[1][]{colback=learncode, colframe=learnmuted,
  boxrule=0.4pt, arc=2pt, left=6pt, right=6pt, #1}

% "Underneath" note explaining what a construct costs.
\newcommand{\underneath}[1]{\par\textbf{Underneath:} #1\par}
