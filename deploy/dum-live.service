[Unit]
Description=Dum live view: hub's virtual screen in a private Discord channel
After=network-online.target hub-screen.service
Wants=network-online.target

[Service]
# Ryan's clock (Indiana), not hub's UTC: anything that reads the local date or time.
Environment=TZ=America/Indiana/Indianapolis
Type=simple
WorkingDirectory=/home/ryanhubbart/code2/dum-intern
EnvironmentFile=%h/.config/dum-discord/environment
Environment=DUM_DISCORD_STATE_DIR=%h/.local/state/dum-discord
Environment=DUM_LIVE_DISPLAY=:99
Environment=DUM_LIVE_VIEWER_URL=http://100.109.151.100:6080/vnc.html?autoconnect=true&resize=scale
ExecStart=/usr/local/bin/node --import tsx src/live/stream.ts
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
