# A virtual screen on hub (display :99) that agents use and Ryan watches through noVNC.
# hub-screen-wm, -vnc, -web and browseros-hub all hang off this one.
[Unit]
Description=Hub virtual screen (Xvfb :99)

[Service]
ExecStart=/usr/bin/Xvfb :99 -screen 0 1600x1000x24 -nolisten tcp -ac
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
