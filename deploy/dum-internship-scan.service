[Unit]
Description=Dum: check internship boards and ping Ryan about new matches (read and notify only)
After=network-online.target
Wants=network-online.target

[Service]
# Ryan's clock (Indiana), not hub's UTC: anything that reads the local date or time.
Environment=TZ=America/Indiana/Indianapolis
Type=oneshot
WorkingDirectory=/home/ryanhubbart/code2/dum-intern
EnvironmentFile=%h/.config/dum-discord/environment
Environment=DUM_DISCORD_STATE_DIR=%h/.local/state/dum-discord
Environment=DUM_INTERNSHIP_STATE_DIR=%h/.local/state/dum-internship
ExecStart=/usr/local/bin/node --import tsx src/internship/watch.ts scan
TimeoutStartSec=10min
UMask=0077
