# BrowserOS on hub's virtual screen, with its own profile. Its MCP server answers at
# http://127.0.0.1:9200/mcp (registered for Claude Code as browseros-hub). BrowserOS binds its
# ports on every interface, so hub-browseros-guard keeps them to loopback and the tailnet.
[Unit]
Description=BrowserOS on hub's virtual screen
BindsTo=hub-screen.service
After=hub-screen-wm.service

[Service]
Environment=DISPLAY=:99
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -e /tmp/.X11-unix/X99 ] && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/browseros --user-data-dir=%h/.config/browseros-hub --no-first-run --start-maximized --window-size=1600,1000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
