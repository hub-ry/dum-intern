[Unit]
Description=Keep BrowserOS agent ports off the LAN (loopback and tailnet only)
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/hub-browseros-guard.nft
ExecStop=/usr/sbin/nft delete table inet hub_browseros_guard

[Install]
WantedBy=multi-user.target
