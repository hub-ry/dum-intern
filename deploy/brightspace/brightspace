#!/bin/sh
# Launcher for the pinned brightspace-mcp-server that Dum's chat turns start (src/discord/chat.ts).
# Installed as ~/opt/brightspace-mcp/bin/brightspace next to package.json from deploy/brightspace.
#   brightspace            the MCP server on stdio (what Dum launches)
#   brightspace setup      one-time Purdue setup with automatic (TOTP) sign-in; Ryan runs it himself.
#                          It is setup.mjs here, not the package wizard, which offers to register npx ...@latest.
#   brightspace auth       sign in again by hand (--logout forgets the saved session)
#   brightspace doctor     the package's own checks
# It never updates itself: to upgrade, change the exact version in package.json, npm ci, re-verify.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUILD="$DIR/node_modules/brightspace-mcp-server/build"
NODE=$(command -v node || true)
[ -n "$NODE" ] || NODE=$(ls -d "$HOME"/.nvm/versions/node/v2[4-9]*/bin/node 2>/dev/null | sort -V | tail -n 1)
[ -n "$NODE" ] || { echo "brightspace: no node on PATH or in ~/.nvm" >&2; exit 127; }
# Without this the CLI re-runs itself through `npx brightspace-mcp-server@latest`.
export D2L_NO_UPDATE_CHECK=1
# Purdue (West Lafayette) time, so due dates and "due in" read right; hub's clock is UTC.
export TZ=America/Indiana/Indianapolis
# The keyring is on the user D-Bus, and turns started by systemd-run don't carry its address.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
# secret-tool lives in /usr/bin; the server finds it on PATH.
export PATH="$(dirname -- "$NODE"):/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"
cd "$DIR"
case "${1:-}" in
  setup)  shift; exec "$NODE" "$DIR/bin/setup.mjs" "$@" ;;
  auth)   shift; exec "$NODE" "$BUILD/auth-cli.js" "$@" ;;
  doctor) shift; exec "$NODE" "$BUILD/doctor.js" "$@" ;;
  *)      exec "$NODE" "$BUILD/index.js" "$@" ;;
esac
