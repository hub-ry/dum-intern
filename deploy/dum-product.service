# Serves dumintern.com: the public pages and the signed-in Dum workspace.
# Install: sudo cp deploy/dum-product.service /etc/systemd/system/ && sudo systemctl enable --now dum-product
# Listens on 127.0.0.1:8074. cloudflared forwards dumintern.com here.
# State is /home/ryanhubbart/.local/state/dum-product (one folder per GitHub account).

[Unit]
Description=Dum product site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ryanhubbart
Group=ryanhubbart
WorkingDirectory=/home/ryanhubbart/code/dum-intern
ExecStart=/home/ryanhubbart/code/dum-intern/node_modules/.bin/tsx src/product/server.ts
Environment=HOME=/home/ryanhubbart
Environment=HOST=127.0.0.1
Environment=PORT=8074
Environment=DUM_PRODUCT_STATE=/home/ryanhubbart/.local/state/dum-product
Environment=DUM_PDFJS=/home/ryanhubbart/code/learn/node_modules/pdfjs-dist/build
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
